{
  "name": "devnote",
  "main": "src/index.ts",
  "compatibility_date": "2025-01-01",
  "assets": {
    "directory": "../frontend/out",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "ai": {
    "binding": "AI"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "devnote-db",
      "database_id": "56502cb8-e7bb-4118-beb6-a807df4a5c0f",
      "migrations_dir": "migrations"
    }
  ]
}
